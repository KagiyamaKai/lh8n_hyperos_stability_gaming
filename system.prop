# Uncap games from Android 15/16 default 60Hz SurfaceFlinger throttle on 120Hz panel
persist.graphics.game_default_frame_rate.enabled=false
ro.surface_flinger.game_default_frame_rate_override=0

# Match dex2oat CPU set to all 6 Cortex-A55 cores (0-5) with 4 background threads
dalvik.vm.image-dex2oat-cpu-set=0,1,2,3,4,5
dalvik.vm.background-dex2oat-cpu-set=0,1,2,3,4,5
dalvik.vm.background-dex2oat-threads=4

# Restore AOSP ART madvise hints (overridden to 0 in donor /product/etc/build.prop)
dalvik.vm.madvise.vdexfile.size=104857600
dalvik.vm.madvise.odexfile.size=104857600
dalvik.vm.madvise.artfile.size=8388608

